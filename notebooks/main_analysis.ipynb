crop_suitability_rows = []
crop_class_distribution_rows = []

regional_gaez_arrays = {}
regional_gaez_metadata = {}

for _, file_record in gaez_file_inventory.iterrows():

    crop_name = file_record["crop"]
    file_path = file_record["file_path"]

    # Extract the GAEZ classes over the regional study area
    regional_array, raster_metadata = (
        extract_gaez_region(file_path)
    )

    regional_gaez_arrays[crop_name] = regional_array
    regional_gaez_metadata[crop_name] = raster_metadata

    # Retain finite values and convert them to integer class codes
    valid_classes = regional_array[
        np.isfinite(regional_array)
    ].astype(int)

    # Count all valid pixels before excluding water
    total_valid_pixels = int(
        len(valid_classes)
    )

    # GAEZ class 9 represents water
    water_pixels = int(
        np.sum(valid_classes == 9)
    )

    # Retain agricultural land classes 1–8
    agricultural_classes = valid_classes[
        np.isin(
            valid_classes,
            np.arange(1, 9)
        )
    ]

    # Handle crops with no valid agricultural pixels
    if len(agricultural_classes) == 0:

        crop_suitability_rows.append({
            "crop": crop_name,
            "total_valid_pixels": total_valid_pixels,
            "valid_land_pixels": 0,
            "water_pixels": water_pixels,
            "dominant_class_code": np.nan,
            "dominant_class": "Unavailable",
            "regional_suitability_score": np.nan,
            "data_status": (
                "No valid agricultural pixels"
            )
        })

        continue

    # Count the occurrence of each suitability class
    class_codes, class_counts = np.unique(
        agricultural_classes,
        return_counts=True
    )

    # Identify the most frequent suitability class
    dominant_position = np.argmax(
        class_counts
    )

    dominant_class_code = int(
        class_codes[dominant_position]
    )

    # Convert official ordinal classes to the project's
    # transparent 0–1 screening scale
    pixel_scores = np.array([
        gaez_class_scores[int(class_code)]
        for class_code in agricultural_classes
    ])

    regional_score = float(
        np.mean(pixel_scores)
    )

    crop_suitability_rows.append({
        "crop": crop_name,
        "total_valid_pixels": total_valid_pixels,
        "valid_land_pixels": int(
            len(agricultural_classes)
        ),
        "water_pixels": water_pixels,
        "dominant_class_code": dominant_class_code,
        "dominant_class": (
            gaez_class_labels[
                dominant_class_code
            ]
        ),
        "regional_suitability_score": regional_score,
        "data_status": "Available"
    })

    # Calculate the regional percentage of each class
    total_land_pixels = len(
        agricultural_classes
    )

    for class_code, class_count in zip(
        class_codes,
        class_counts
    ):

        crop_class_distribution_rows.append({
            "crop": crop_name,
            "class_code": int(class_code),
            "class_label": (
                gaez_class_labels[
                    int(class_code)
                ]
            ),
            "pixel_count": int(class_count),
            "percentage": float(
                class_count
                / total_land_pixels
                * 100
            )
        })
crop_suitability_summary = pd.DataFrame(
