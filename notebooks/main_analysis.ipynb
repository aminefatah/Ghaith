def calculate_current_regional_shares(
    allocations
):
    if allocations.empty:
        return {}, {}

    total_area = (
        allocations["allocated_area_ha"].sum()
    )

    if total_area == 0:
        return {}, {}

    crop_shares = (
        allocations
        .groupby("crop")[
            "allocated_area_ha"
        ]
        .sum()
        .div(total_area)
        .to_dict()
    )

    family_shares = (
        allocations
        .groupby("crop_family")[
            "allocated_area_ha"
        ]
        .sum()
        .div(total_area)
        .to_dict()
    )

    return crop_shares, family_shares
