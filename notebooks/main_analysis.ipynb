from rasterio.windows import from_bounds

def extract_gaez_region(file_path):

    with rasterio.open(file_path) as source:

        window = from_bounds(
            gaez_west,
            gaez_south,
            gaez_east,
            gaez_north,
            transform=source.transform
        )

        window = (
            window
            .round_offsets()
            .round_lengths()
        )

        regional_array = source.read(
            1,
            window=window,
            boundless=True,
            fill_value=source.nodata
        ).astype(float)

        regional_transform = (
            source.window_transform(window)
        )

        raster_metadata = {
            "crs": str(source.crs),
            "resolution_x": source.res[0],
            "resolution_y": source.res[1],
            "transform": regional_transform,
            "nodata": source.nodata
        }

    if raster_metadata["nodata"] is not None:
        regional_array[
            regional_array
            == raster_metadata["nodata"]
        ] = np.nan

    # Retain only documented class codes 1–9
    regional_array[
        ~np.isin(
            regional_array,
            np.arange(1, 10)
        )
    ] = np.nan

    return regional_array, raster_metadata
