def find_single_band(pattern):
    matches = [
        file_path
        for file_path in jp2_files
        if pattern in file_path.name
    ]

    if not matches:
        raise FileNotFoundError(
            f"No band matching '{pattern}' was found."
        )

    return matches[0]


