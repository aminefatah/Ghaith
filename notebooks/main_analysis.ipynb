def read_soilgrids_layer(
    property_code,
    depth
):
    matching_record = next(
        record
        for record in downloaded_soil_layers
        if (
            record["property"] == property_code
            and record["depth"] == depth
        )
    )

    with rasterio.open(
        matching_record["file_path"]
    ) as source:

        array = source.read(1).astype(float)

        if source.nodata is not None:
            array[array == source.nodata] = np.nan

    conversion_factor = soil_properties[
        property_code
    ]["conversion_factor"]

    return array / conversion_factor
