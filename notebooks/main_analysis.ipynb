downloaded_soil_layers = []

for property_code in soil_properties:

    print(
        f"\nConnecting to SoilGrids property: "
        f"{property_code}"
    )

    service_url = (
        "https://maps.isric.org/mapserv"
        f"?map=/map/{property_code}.map"
    )

    wcs = WebCoverageService(
        service_url,
        version="1.0.0",
        timeout=120
    )

    available_coverages = list(
        wcs.contents.keys()
    )

    for depth in soil_depths:

        matching_coverages = [
            coverage
            for coverage in available_coverages
            if (
                coverage.startswith(
                    f"{property_code}_{depth}"
                )
                and "Q0.5" in coverage
            )
        ]

        if not matching_coverages:
            print(
                "Coverage not found:",
                property_code,
                depth
            )
            continue

        coverage_id = matching_coverages[0]

        output_path = (
            f"{soil_output_folder}/"
            f"{coverage_id}.tif"
        )

        try:
            response = wcs.getCoverage(
                identifier=coverage_id,
                crs=(
                    "urn:ogc:def:crs:"
                    "EPSG::152160"
                ),
                bbox=soilgrids_bbox,
                resx=250,
                resy=250,
                format="GEOTIFF_INT16"
            )

            with open(
                output_path,
                "wb"
            ) as output_file:
                output_file.write(
                    response.read()
                )

            downloaded_soil_layers.append({
                "property": property_code,
                "depth": depth,
                "coverage_id": coverage_id,
                "file_path": output_path
            })

            print("Downloaded:", coverage_id)

        except Exception as error:
            print(
                "Download failed:",
                coverage_id
            )
            print("Error:", error)

