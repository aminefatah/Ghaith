def percentile_stretch(
    band,
    lower_percentile=2,
    upper_percentile=98
):
    valid_pixels = band[
        np.isfinite(band) & (band > 0)
    ]

    if valid_pixels.size == 0:
        raise ValueError(
            "The band contains no valid positive pixels."
        )

    lower_value = np.percentile(
        valid_pixels,
        lower_percentile
    )

    upper_value = np.percentile(
        valid_pixels,
        upper_percentile
    )

    if upper_value == lower_value:
        return np.zeros_like(
            band,
            dtype="float32"
        )

    stretched = (
        band - lower_value
    ) / (
        upper_value - lower_value
    )

    return np.clip(stretched, 0, 1)
rgb_image = np.dstack([
    percentile_stretch(red_reflectance),
    percentile_stretch(green_reflectance),
    percentile_stretch(blue_reflectance)
])

