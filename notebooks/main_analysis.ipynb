def standardize_crop_name(crop_name):
    if pd.isna(crop_name):
        return np.nan

    name = str(crop_name).strip().lower()

    crop_name_mapping = {
        "wheat": "Wheat",
        "barley": "Barley",
        "maize": "Maize",
        "corn": "Maize",
        "chickpea": "Chickpea",
        "lentil": "Lentil",
        "faba bean": "Faba bean",
        "faba beans": "Faba bean",
        "broad bean": "Faba bean",
        "alfalfa": "Alfalfa",
        "forage oats": "Forage oats",
        "oats": "Forage oats"
    }

    return crop_name_mapping.get(name, str(crop_name).strip())


