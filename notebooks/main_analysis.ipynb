Farm-size thresholds are prototype categories. Pasture area is not added to feed tonnes because it requires a forage-yield conversion.
def classify_livestock_situation(row):
    sheep = row["number_of_sheep"]
    cattle = row["number_of_cattle"]
    if sheep == 0 and cattle == 0: return "No livestock"
    if sheep > 0 and cattle == 0: return "Sheep only"
    if sheep == 0 and cattle > 0: return "Cattle only"
    return "Sheep and cattle"

def classify_farm_size(area_ha):
    if area_ha < 5: return "Small"
    if area_ha < 12: return "Medium"
    return "Large"

