def identify_gaez_crop(file_path):

    file_name = os.path.basename(
        file_path
    ).upper()

    for crop_code, crop_name in (
        crop_code_mapping.items()
    ):
        if f".{crop_code}." in file_name:
            return crop_name

    return "Unknown"


