import rasterio
import pandas as pd
gaez_file_checks = []

for file_path in gaez_tif_files:

    try:
        with rasterio.open(file_path) as source:

            raster_array = source.read(1)

            if source.nodata is not None:
                valid_values = raster_array[
                    raster_array != source.nodata
                ]
            else:
                valid_values = raster_array.ravel()

            unique_values = np.unique(
                valid_values
            )

            gaez_file_checks.append({
                "file_name": os.path.basename(
                    file_path
                ),
                "opens_successfully": True,
                "width": source.width,
                "height": source.height,
                "bands": source.count,
                "crs": str(source.crs),
                "nodata": source.nodata,
                "minimum_class": (
                    int(np.min(unique_values))
                    if len(unique_values) > 0
                    else np.nan
                ),
                "maximum_class": (
                    int(np.max(unique_values))
                    if len(unique_values) > 0
                    else np.nan
                ),
                "unique_classes": (
                    unique_values.tolist()
                )
            })

    except Exception as error:

        gaez_file_checks.append({
            "file_name": os.path.basename(
                file_path
            ),
            "opens_successfully": False,
            "error": str(error)
        })

