def allocate_farmer_land(
    farmer,
    farmer_scores,
    crop_database,
    maximum_crops=5
):
    eligible_scores = (
        farmer_scores[
            farmer_scores["eligible"]
        ]
        .dropna(
            subset=["final_score"]
        )
        .sort_values(
            "final_score",
            ascending=False
        )
        .head(maximum_crops)
        .copy()
    )

    if eligible_scores.empty:
        raise ValueError(
            f"No eligible crops for "
            f"{farmer['farmer_id']}."
        )

    eligible_scores = eligible_scores.merge(
        crop_database[
            [
                "crop",
                "maximum_allocation_fraction"
            ]
        ],
        on="crop",
        how="left"
    )

    minimum_feed_fraction = 0.0

    if farmer["farm_area_ha"] > 0:
        minimum_feed_fraction = (
            farmer[
                "recommended_minimum_feed_area_ha"
            ]
            / farmer["farm_area_ha"]
        )

    minimum_feed_fraction = float(
        np.clip(
            minimum_feed_fraction,
            0,
            0.50
        )
    )

    allocation_weight = (
        eligible_scores["final_score"].clip(
            lower=0.001
        )
    )

    feed_oriented = (
        eligible_scores["crop_function"]
        .str.contains(
            "feed|forage",
            case=False,
            regex=True
        )
    )

    allocation_weight = (
        allocation_weight
        * np.where(
            feed_oriented,
            1.0 + minimum_feed_fraction,
            1.0
        )
    )

    raw_fraction = (
        allocation_weight
        / allocation_weight.sum()
    )

    capped_fraction = np.minimum(
        raw_fraction,
        eligible_scores[
            "maximum_allocation_fraction"
        ]
    )

    if capped_fraction.sum() == 0:
        capped_fraction = raw_fraction

    normalized_fraction = (
        capped_fraction
        / capped_fraction.sum()
    )

    eligible_scores[
        "allocation_fraction"
    ] = normalized_fraction

    eligible_scores["allocated_area_ha"] = (
        eligible_scores["allocation_fraction"]
        * farmer["farm_area_ha"]
    )

    eligible_scores["allocation_percent"] = (
        eligible_scores["allocation_fraction"]
        * 100
    )

    eligible_scores[
        "farmer_id"
    ] = farmer["farmer_id"]

    eligible_scores[
        "farm_area_ha"
    ] = farmer["farm_area_ha"]

    return eligible_scores[
        [
            "farmer_id",
            "crop",
            "crop_family",
            "crop_function",
            "final_score",
            "allocation_fraction",
            "allocation_percent",
            "allocated_area_ha",
            "farm_area_ha"
        ]
    ]
independent_allocation_frames = []

