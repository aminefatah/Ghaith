### 13.1.2 Exclusion rules

A crop is excluded when it requires irrigation but the farmer has no irrigation, or when its aligned environmental suitability is below the prototype threshold. The reasons are retained in the score table for transparency.

def evaluate_crop_eligibility(farmer, crop):
    reasons = []

    if crop["irrigation_required"] and not farmer["irrigation_available"]:
        reasons.append("Irrigation is required but unavailable.")

    suitability = float(crop["aligned_environmental_suitability"])
    if suitability < MINIMUM_SUITABILITY:
        reasons.append(
            "Environmental suitability is below the prototype threshold."
        )

    return len(reasons) == 0, reasons

### 13.1.3 Water-compatibility score

For rain-fed farms, compatibility increases as relative crop-water demand decreases. For irrigated farms, crop demand is compared with a prototype available-water score derived from irrigation reliability.

def calculate_water_compatibility(farmer, crop):
    crop_water_demand = float(crop["water_requirement_score"])
    irrigation_score = IRRIGATION_RELIABILITY_SCORE.get(
        farmer["irrigation_reliability"],
        0.0
    )

    if not farmer["irrigation_available"]:
        if not crop["rainfed_possible"]:
            return 0.0
        return float(np.clip(1.0 - crop_water_demand, 0, 1))

    available_water_score = 0.40 + 0.60 * irrigation_score
    compatibility = 1.0 - abs(
        crop_water_demand - available_water_score
    )
    return float(np.clip(compatibility, 0, 1))

### 13.1.4 Rotation score

The rotation score combines compatibility between the previous and candidate crop families with the crop's prototype rotation-benefit indicator.

def calculate_rotation_score(farmer, crop):
    previous_family = farmer["previous_crop_family"]
    candidate_family = crop["crop_family"]

    if previous_family in ["None", "Unknown"]:
        family_compatibility = 0.70
    elif previous_family == candidate_family:
        family_compatibility = 0.20
    elif previous_family == "Cereal" and candidate_family in [
        "Legume", "Forage legume"
    ]:
        family_compatibility = 1.00
    elif previous_family in ["Legume", "Forage legume"] and candidate_family == "Cereal":
        family_compatibility = 0.90
    else:
        family_compatibility = 0.75

    combined = (
        0.60 * family_compatibility
        + 0.40 * float(crop["rotation_benefit"])
    )
    return float(np.clip(combined, 0, 1))

### 13.1.5 Feed-contribution score

For scenarios without livestock, a neutral value is used. For livestock scenarios, direct feed and residue contributions are combined and become more influential as the estimated feed-gap ratio increases.

def calculate_feed_contribution_score(farmer, crop):
    if farmer["number_of_sheep"] == 0 and farmer["number_of_cattle"] == 0:
        return 0.50

    crop_feed_value = (
        0.70 * float(crop["feed_contribution"])
        + 0.30 * float(crop["residue_feed_contribution"])
    )
    feed_gap_intensity = float(farmer["feed_gap_ratio"])

    feed_score = crop_feed_value * (
        0.40 + 0.60 * feed_gap_intensity
    )
    return float(np.clip(feed_score, 0, 1))

### 13.1.6 Objective-compatibility score

The farmer's primary objective selects or combines the relevant candidate-crop indicators. Unrecognized objectives receive a neutral score of 0.50.

def calculate_objective_compatibility(farmer, crop):
    objective = farmer["primary_objective"]

    if objective == "Household food":
        score = crop["household_food_contribution"]
    elif objective in ["Livestock feed", "Cattle feed", "Reduce feed gap"]:
        score = (
            0.75 * crop["feed_contribution"]
            + 0.25 * crop["residue_feed_contribution"]
        )
    elif objective == "Income generation":
        score = crop["income_potential"]
    elif objective == "Crop rotation":
        score = crop["rotation_benefit"]
    elif objective == "Diversified production":
        score = (
            0.25 * crop["household_food_contribution"]
            + 0.25 * crop["feed_contribution"]
            + 0.25 * crop["rotation_benefit"]
            + 0.25 * crop["income_potential"]
        )
    elif objective == "Balanced food and feed":
        score = (
            0.50 * crop["household_food_contribution"]
            + 0.50 * crop["feed_contribution"]
        )
    else:
        score = 0.50

    return float(np.clip(score, 0, 1))

### 13.1.7 Environmental and diversification scores

Environmental suitability uses the aligned value created in Sections 8.1.4 and 8.1.5. The diversity score rewards crops and crop families with smaller shares in the allocations already processed. The first farmer receives the maximum diversity score for all crops because no prior allocation exists.

def calculate_environmental_suitability(farmer, crop):
    return float(np.clip(
        crop["aligned_environmental_suitability"],
        0,
        1
    ))


def calculate_diversity_benefit(crop, crop_share, family_share):
    current_crop_share = crop_share.get(crop["crop"], 0.0)
    current_family_share = family_share.get(crop["crop_family"], 0.0)

    benefit = (
        0.60 * (1.0 - current_crop_share)
        + 0.40 * (1.0 - current_family_share)
    )
    return float(np.clip(benefit, 0, 1))

### 13.1.8 Final crop score

Each eligible farmer-crop pair receives a weighted score. Ineligible combinations retain their component scores for inspection but receive no final score.

def calculate_crop_score(component_values, weights=BASELINE_WEIGHTS):
    return float(sum(
        component_values[key] * weights[key]
        for key in weights
    ))


def score_farmer_crop_combination(
    farmer,
    crop,
    crop_share=None,
    family_share=None,
    use_diversity=False
):
    crop_share = {} if crop_share is None else crop_share
    family_share = {} if family_share is None else family_share

    eligible, exclusion_reasons = evaluate_crop_eligibility(farmer, crop)

    components = {
        "environmental_suitability": calculate_environmental_suitability(farmer, crop),
        "water_compatibility": calculate_water_compatibility(farmer, crop),
        "objective_compatibility": calculate_objective_compatibility(farmer, crop),
        "feed_contribution": calculate_feed_contribution_score(farmer, crop),
        "rotation_benefit": calculate_rotation_score(farmer, crop),
        "diversity_benefit": (
            calculate_diversity_benefit(crop, crop_share, family_share)
            if use_diversity else 0.50
        ),
        "soil_health_benefit": float(crop["soil_health_benefit"])
    }

    final_score = (
        calculate_crop_score(components)
        if eligible else np.nan
    )

    return {
        "farmer_id": farmer["farmer_id"],
        "crop": crop["crop"],
        "crop_family": crop["crop_family"],
        "crop_function": crop["crop_function"],
        "eligible": eligible,
        "exclusion_reasons": "; ".join(exclusion_reasons),
        **components,
        "final_score": final_score,
        "suitability_value_source": crop.get(
            "suitability_value_source",
            "Not documented"
        ),
        "suitability_is_assumption": crop.get(
            "suitability_is_assumption",
            True
        )
    }

### 13.1.9 Land-allocation constraints

Up to five eligible crops are selected per farm. Area is allocated in proportion to score, with a moderate feed-gap boost for feed-oriented crops. An iterative capped-allocation procedure ensures that each crop respects its maximum allocation fraction while the farm total remains 100%.

The existing minimum-allocation values are zero for all current candidates. The function nevertheless supports positive minimum fractions if they are introduced later.

def bounded_proportional_allocation(weights, minimums, maximums):
    weights = np.asarray(weights, dtype=float)
    minimums = np.asarray(minimums, dtype=float)
    maximums = np.asarray(maximums, dtype=float)

    assert np.all(minimums >= 0)
    assert np.all(maximums <= 1)
    assert np.all(minimums <= maximums)
    assert minimums.sum() <= 1 + 1e-9
    assert maximums.sum() >= 1 - 1e-9, (
        "Selected crop maximum fractions cannot cover the full farm."
    )

    allocation = minimums.copy()
    remaining = 1.0 - allocation.sum()
    active = allocation < maximums - 1e-12

    while remaining > 1e-10 and active.any():
        active_weights = np.where(active, np.maximum(weights, 1e-9), 0.0)
        proposed = remaining * active_weights / active_weights.sum()
        capacity = maximums - allocation
        addition = np.minimum(proposed, capacity)
        allocation += addition
        new_remaining = 1.0 - allocation.sum()

        if np.isclose(new_remaining, remaining, atol=1e-12):
            break
        remaining = new_remaining
        active = allocation < maximums - 1e-12

    if remaining > 1e-8:
        raise ValueError("Unable to allocate 100% within crop constraints.")

    allocation = allocation / allocation.sum()
    return allocation


def allocate_farmer_land(
    farmer,
    farmer_scores,
    crop_database,
    maximum_crops=MAXIMUM_CROPS_PER_FARM
):
    eligible_scores = (
        farmer_scores[farmer_scores["eligible"]]
        .dropna(subset=["final_score"])
        .sort_values("final_score", ascending=False)
        .head(maximum_crops)
        .copy()
    )

    if eligible_scores.empty:
        raise ValueError(f"No eligible crops for {farmer['farmer_id']}.")

    constraint_columns = [
        "crop", "minimum_allocation_fraction",
        "maximum_allocation_fraction"
    ]
    eligible_scores = eligible_scores.merge(
        crop_database[constraint_columns],
        on="crop",
        how="left",
        validate="one_to_one"
    )

    minimum_feed_fraction = float(np.clip(
        farmer["recommended_minimum_feed_area_ha"] / farmer["farm_area_ha"],
        0,
        0.50
    ))

    feed_oriented = eligible_scores["crop_function"].str.contains(
        "feed|forage",
        case=False,
        regex=True
    )

    allocation_weights = eligible_scores["final_score"].clip(lower=0.001)
    allocation_weights = allocation_weights * np.where(
        feed_oriented,
        1.0 + minimum_feed_fraction,
        1.0
    )

    fractions = bounded_proportional_allocation(
        weights=allocation_weights.to_numpy(),
        minimums=eligible_scores["minimum_allocation_fraction"].to_numpy(),
        maximums=eligible_scores["maximum_allocation_fraction"].to_numpy()
    )

    eligible_scores["allocation_fraction"] = fractions
    eligible_scores["allocation_percent"] = fractions * 100
    eligible_scores["allocated_area_ha"] = fractions * farmer["farm_area_ha"]
    eligible_scores["farmer_id"] = farmer["farmer_id"]
    eligible_scores["farm_area_ha"] = farmer["farm_area_ha"]

    return eligible_scores[
        [
            "farmer_id", "crop", "crop_family", "crop_function",
            "final_score", "diversity_benefit", "allocation_fraction",
            "allocation_percent", "allocated_area_ha", "farm_area_ha",
            "minimum_allocation_fraction", "maximum_allocation_fraction"
        ]
    ]

## 13.2 Independent Allocation

Each farmer is scored using a neutral diversity value of 0.50. Allocations are made without considering crop shares in other scenarios.

independent_score_records = []

for _, farmer in synthetic_farmers.iterrows():
    for _, crop in crop_database_model.iterrows():
        independent_score_records.append(
            score_farmer_crop_combination(
                farmer=farmer,
                crop=crop,
                use_diversity=False
            )
        )

independent_scores = pd.DataFrame(independent_score_records)
independent_scores["rank"] = (
    independent_scores.groupby("farmer_id")["final_score"]
    .rank(ascending=False, method="dense")
)

