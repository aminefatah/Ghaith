def find_band_in_safe(
    safe_directory,
    filename_pattern
):
    safe_jp2_files = list(
        safe_directory.rglob("*.jp2")
    )

    matches = [
        file_path
        for file_path in safe_jp2_files
        if filename_pattern in file_path.name
    ]

    if len(matches) == 0:
        raise FileNotFoundError(
            "No file matching "
            f"'{filename_pattern}' was found in "
            f"{safe_directory.name}."
        )

    if len(matches) != 1:
        raise ValueError(
            f"Expected exactly one file matching "
            f"'{filename_pattern}' in "
            f"{safe_directory.name}, but found "
            f"{len(matches)}."
        )

    return matches[0]
