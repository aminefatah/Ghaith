## 13.3 Diversity-Aware Allocation

Farmers are processed in identifier order. Before each farmer is scored, the running crop and crop-family shares are calculated from allocations already made. Crops and families with lower prior shares receive higher diversity benefits.

Because this is a sequential heuristic, results may depend on farmer processing order. The method is transparent and suitable for prototype comparison, but it is not a globally optimized regional allocation.

def calculate_current_regional_shares(allocations):
    if allocations.empty:
        return {}, {}

    total_area = allocations["allocated_area_ha"].sum()
    if total_area <= 0:
        return {}, {}

    crop_shares = (
        allocations.groupby("crop")["allocated_area_ha"]
        .sum().div(total_area).to_dict()
    )
    family_shares = (
        allocations.groupby("crop_family")["allocated_area_ha"]
        .sum().div(total_area).to_dict()
    )
    return crop_shares, family_shares


diversity_score_records = []
diversity_allocation_frames = []
running_allocations = pd.DataFrame()

for _, farmer in synthetic_farmers.sort_values("farmer_id").iterrows():
    crop_share, family_share = calculate_current_regional_shares(
        running_allocations
    )

    current_records = []
    for _, crop in crop_database_model.iterrows():
        record = score_farmer_crop_combination(
            farmer=farmer,
            crop=crop,
            crop_share=crop_share,
            family_share=family_share,
            use_diversity=True
        )
        current_records.append(record)
        diversity_score_records.append(record)

    current_scores = pd.DataFrame(current_records)
    current_scores["rank"] = current_scores["final_score"].rank(
        ascending=False,
        method="dense"
    )

    current_allocation = allocate_farmer_land(
        farmer=farmer,
        farmer_scores=current_scores,
        crop_database=crop_database_model
    )
    diversity_allocation_frames.append(current_allocation)
    running_allocations = pd.concat(
        [running_allocations, current_allocation],
        ignore_index=True
    )

diversity_scores = pd.DataFrame(diversity_score_records)
diversity_scores["rank"] = (
    diversity_scores.groupby("farmer_id")["final_score"]
    .rank(ascending=False, method="dense")
)
diversity_allocations = pd.concat(
    diversity_allocation_frames,
    ignore_index=True
)

