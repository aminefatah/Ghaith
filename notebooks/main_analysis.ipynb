MINIMUM_SUITABILITY = 0.40

def evaluate_crop_eligibility(*, farmer, crop):
    reasons = []

    if (
        bool(crop["irrigation_required"])
        and not bool(farmer["irrigation_available"])
    ):
        reasons.append(
            "Irrigation is required but unavailable."
        )

    suitability = float(
        crop["aligned_environmental_suitability"]
    )

    if suitability < MINIMUM_SUITABILITY:
        reasons.append(
            "Environmental suitability is below the "
            "prototype threshold."
        )

    return len(reasons) == 0, reasons
BASELINE_WEIGHTS = {
    "environmental_suitability": 0.30,
    "water_compatibility": 0.20,
    "objective_compatibility": 0.15,
    "feed_contribution": 0.10,
    "rotation_benefit": 0.10,
    "diversity_benefit": 0.10,
    "soil_health_benefit": 0.05
}

assert np.isclose(
    sum(BASELINE_WEIGHTS.values()),
    1.0
), "Recommendation weights must sum to 1."

display(
    pd.DataFrame(
        BASELINE_WEIGHTS.items(),
        columns=["score_component", "weight"]
    )
)
def calculate_crop_score(
    component_values,
    weights=BASELINE_WEIGHTS
):
    final_score = sum(
        component_values[component]
        * weights[component]
        for component in weights
    )

    return float(
        np.clip(final_score, 0, 1)
    )

IRRIGATION_RELIABILITY_SCORE = {
    "None": 0.00,
    "Limited": 0.35,
    "Moderate": 0.65,
    "Reliable": 1.00
}
def calculate_water_compatibility(
    farmer,
    crop
):
    crop_water_demand = (
        crop["water_requirement_score"]
    )

    irrigation_score = (
        IRRIGATION_RELIABILITY_SCORE.get(
            farmer["irrigation_reliability"],
            0.0
        )
    )

    if not farmer["irrigation_available"]:
        if not crop["rainfed_possible"]:
            return 0.0

        return np.clip(
            1.0 - crop_water_demand,
            0,
            1
        )

    available_water_score = (
        0.40
        + 0.60 * irrigation_score
    )

    water_compatibility = (
        1.0
        - abs(
            crop_water_demand
            - available_water_score
        )
    )

    return float(
        np.clip(
            water_compatibility,
            0,
            1
        )
    )
def calculate_rotation_score(
    farmer,
    crop
):
    previous_family = (
        farmer["previous_crop_family"]
    )

    candidate_family = (
        crop["crop_family"]
    )

    if previous_family in ["None", "Unknown"]:
        family_compatibility = 0.70

    elif previous_family == candidate_family:
        family_compatibility = 0.20

    elif (
        previous_family == "Cereal"
        and candidate_family in [
            "Legume",
            "Forage legume"
        ]
    ):
        family_compatibility = 1.00

    elif (
        previous_family in [
            "Legume",
            "Forage legume"
        ]
        and candidate_family == "Cereal"
    ):
        family_compatibility = 0.90

    else:
        family_compatibility = 0.75

    combined_rotation_score = (
        0.60 * family_compatibility
        + 0.40 * crop["rotation_benefit"]
    )

    return float(
        np.clip(
            combined_rotation_score,
            0,
            1
        )
    )
def calculate_feed_contribution_score(
    farmer,
    crop
):
    if (
        farmer["number_of_sheep"] == 0
        and farmer["number_of_cattle"] == 0
    ):
        return 0.50

    direct_feed_score = (
        crop["feed_contribution"]
    )

    residue_score = (
        crop["residue_feed_contribution"]
    )

    crop_feed_value = (
        0.70 * direct_feed_score
        + 0.30 * residue_score
    )

    feed_gap_intensity = (
        farmer["feed_gap_ratio"]
    )

    feed_score = (
        0.40 * crop_feed_value
        + 0.60
        * crop_feed_value
        * feed_gap_intensity
    )

    return float(
        np.clip(
            feed_score,
            0,
            1
        )
    )
def calculate_objective_compatibility(
    farmer,
    crop
):
    objective = farmer["primary_objective"]

    if objective == "Household food":
        score = crop[
            "household_food_contribution"
        ]

    elif objective in [
        "Livestock feed",
        "Cattle feed",
        "Reduce feed gap"
    ]:
        score = (
            0.75 * crop["feed_contribution"]
            + 0.25
            * crop["residue_feed_contribution"]
        )

    elif objective == "Income generation":
        score = crop["income_potential"]

    elif objective == "Crop rotation":
        score = crop["rotation_benefit"]

    elif objective == "Diversified production":
        score = (
            0.25 * crop[
                "household_food_contribution"
            ]
            + 0.25 * crop["feed_contribution"]
            + 0.25 * crop["rotation_benefit"]
            + 0.25 * crop["income_potential"]
        )

    elif objective == "Balanced food and feed":
        score = (
            0.50 * crop[
                "household_food_contribution"
            ]
            + 0.50 * crop["feed_contribution"]
        )

    else:
        score = 0.50

    return float(
        np.clip(
            score,
            0,
            1
        )
    )
def calculate_environmental_suitability(
    farmer,
    crop
):
    return float(
        np.clip(
            crop["aligned_environmental_suitability"],
            0,
            1
        )
    )
The environmental-suitability component uses the aligned suitability variable
created during environmental data alignment. Regional GAEZ suitability is used
when matching crop evidence is available. When GAEZ evidence is unavailable,
the original baseline suitability is retained as an explicitly flagged
prototype assumption.

The aligned suitability remains a regional screening indicator. It does not
represent parcel-level soil, climate, or satellite-derived suitability.
def calculate_diversity_benefit(
    crop,
    crop_share,
    family_share
):
    current_crop_share = crop_share.get(
        crop["crop"],
        0.0
    )

    current_family_share = family_share.get(
        crop["crop_family"],
        0.0
    )

    crop_diversity_component = (
        1.0 - current_crop_share
    )

    family_diversity_component = (
        1.0 - current_family_share
    )

    diversity_benefit = (
        0.60 * crop_diversity_component
        + 0.40 * family_diversity_component
    )

    return float(
        np.clip(
            diversity_benefit,
            0,
            1
        )
    )
def score_farmer_crop_combination(
    farmer,
    crop,
    crop_share=None,
    family_share=None,
    use_diversity=False
):
    if crop_share is None:
        crop_share = {}

    if family_share is None:
        family_share = {}

    # Keyword arguments prevent reversed inputs
    eligible, exclusion_reasons = evaluate_crop_eligibility(
        farmer=farmer,
        crop=crop
    )

    environmental_suitability = (
        calculate_environmental_suitability(
            farmer=farmer,
            crop=crop
        )
    )

    water_compatibility = (
        calculate_water_compatibility(
            farmer=farmer,
            crop=crop
        )
    )

    objective_compatibility = (
        calculate_objective_compatibility(
            farmer=farmer,
            crop=crop
        )
    )

    feed_contribution_score = (
        calculate_feed_contribution_score(
            farmer=farmer,
            crop=crop
        )
    )

    rotation_score = calculate_rotation_score(
        farmer=farmer,
        crop=crop
    )

    soil_health_score = float(
        crop["soil_health_benefit"]
    )

    if use_diversity:
        diversity_benefit = calculate_diversity_benefit(
            crop=crop,
            crop_share=crop_share,
            family_share=family_share
        )
    else:
        diversity_benefit = 0.50

    components = {
        "environmental_suitability": (
            environmental_suitability
        ),
        "water_compatibility": (
            water_compatibility
        ),
        "objective_compatibility": (
            objective_compatibility
        ),
        "feed_contribution": (
            feed_contribution_score
        ),
        "rotation_benefit": (
            rotation_score
        ),
        "diversity_benefit": (
            diversity_benefit
        ),
        "soil_health_benefit": (
            soil_health_score
        )
    }

    if eligible:
        final_score = calculate_crop_score(
            components
        )
    else:
        final_score = np.nan

    return {
        "farmer_id": farmer["farmer_id"],
        "crop": crop["crop"],
        "crop_family": crop["crop_family"],
        "crop_function": crop["crop_function"],
        "eligible": eligible,
        "exclusion_reasons": "; ".join(
            exclusion_reasons
        ),
        **components,
        "final_score": final_score,
        "suitability_value_source": crop.get(
            "suitability_value_source",
            "Not documented"
        ),
        "suitability_is_assumption": crop.get(
            "suitability_is_assumption",
            True
        )
    }
