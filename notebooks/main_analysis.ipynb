## 13.4 Allocation Validation

Both approaches must allocate exactly 100% of each farm, reproduce the total farm area, and respect each selected crop's minimum and maximum fractions.

def validate_allocations(allocations, label):
    check = (
        allocations.groupby("farmer_id")
        .agg(
            allocated_fraction=("allocation_fraction", "sum"),
            allocated_area_ha=("allocated_area_ha", "sum"),
            farm_area_ha=("farm_area_ha", "first")
        )
        .reset_index()
    )

    assert np.allclose(check["allocated_fraction"], 1.0)
    assert np.allclose(check["allocated_area_ha"], check["farm_area_ha"])
    assert (
        allocations["allocation_fraction"]
        >= allocations["minimum_allocation_fraction"] - 1e-9
    ).all()
    assert (
        allocations["allocation_fraction"]
        <= allocations["maximum_allocation_fraction"] + 1e-9
    ).all()
    assert allocations["allocation_fraction"].between(0, 1).all()

    print(f"{label} allocations passed validation.")
    return check


independent_allocation_check = validate_allocations(
    independent_allocations,
    "Independent"
)
diversity_allocation_check = validate_allocations(
    diversity_allocations,
    "Diversity-aware"
)

display(independent_allocation_check.round(4))
display(diversity_allocation_check.round(4))

## 12.2 Regional Diversity Metrics

Area-weighted regional shares are used to calculate concentration and diversity. Shannon diversity is calculated as \( -\sum p_i \ln(p_i) \), while HHI is \( \sum p_i^2 \). Higher Shannon diversity and a larger effective number of crops indicate greater diversity. Lower HHI and a smaller dominant crop share indicate lower concentration.

def calculate_regional_diversity_metrics(allocations, approach):
    total_area = allocations["allocated_area_ha"].sum()

    crop_area = allocations.groupby("crop")["allocated_area_ha"].sum()
    crop_share = (crop_area / total_area).sort_values(ascending=False)

    family_area = allocations.groupby("crop_family")["allocated_area_ha"].sum()
    family_share = (family_area / total_area).sort_values(ascending=False)

    positive_crop_shares = crop_share[crop_share > 0]
    shannon = -float(np.sum(
        positive_crop_shares * np.log(positive_crop_shares)
    ))
    hhi = float(np.sum(positive_crop_shares ** 2))

    metrics = {
        "approach": approach,
        "total_allocated_area_ha": total_area,
        "number_of_allocated_crops": int((crop_area > 0).sum()),
        "dominant_crop": crop_share.index[0],
        "dominant_crop_share": float(crop_share.iloc[0]),
        "dominant_family": family_share.index[0],
        "dominant_family_share": float(family_share.iloc[0]),
        "shannon_diversity": shannon,
        "effective_number_of_crops": float(np.exp(shannon)),
        "hhi_concentration": hhi
    }

    crop_table = crop_share.rename("crop_share").reset_index()
    crop_table["approach"] = approach

    family_table = family_share.rename("family_share").reset_index()
    family_table["approach"] = approach

    return metrics, crop_table, family_table


ind_metrics, ind_crop_shares, ind_family_shares = (
    calculate_regional_diversity_metrics(
        independent_allocations,
        "Independent"
    )
)
div_metrics, div_crop_shares, div_family_shares = (
    calculate_regional_diversity_metrics(
        diversity_allocations,
        "Diversity-aware"
    )
)

regional_diversity_comparison = pd.DataFrame([
    ind_metrics,
    div_metrics
])
regional_crop_shares = pd.concat(
    [ind_crop_shares, div_crop_shares],
    ignore_index=True
)
regional_family_shares = pd.concat(
    [ind_family_shares, div_family_shares],
    ignore_index=True
)

display(regional_diversity_comparison.round(4))
display(regional_crop_shares.round(4))
