print("Second-date shape:", second_red_raw.shape)

assert second_blue_raw.shape == red_clipped.shape
assert second_green_raw.shape == red_clipped.shape
assert second_red_raw.shape == red_clipped.shape
assert second_nir_raw.shape == red_clipped.shape
assert second_swir_raw.shape == red_clipped.shape
assert second_scl.shape == red_clipped.shape

print(
    "The second observation is aligned to "
    "the first-date analysis grid."
)
second_blue_reflectance = (
    second_blue_raw / 10000.0
)

second_green_reflectance = (
    second_green_raw / 10000.0
)

second_red_reflectance = (
    second_red_raw / 10000.0
)

second_nir_reflectance = (
    second_nir_raw / 10000.0
)

second_swir_reflectance = (
    second_swir_raw / 10000.0
)
# ---------------------------------------------------------
# 1. SCL quality mask
# ---------------------------------------------------------

excluded_class_codes = list(
    EXCLUDED_SCL_CLASSES.keys()
)

second_scl_invalid_mask = np.isin(
    second_scl,
    excluded_class_codes
)


# ---------------------------------------------------------
# 2. Separate invalid masks for NDVI, NDMI, and RGB
# ---------------------------------------------------------

# NDVI requires red and NIR.
second_ndvi_invalid_mask = (
    second_scl_invalid_mask
    | (second_red_raw == 0)
    | (second_nir_raw == 0)
)

# NDMI requires NIR and SWIR.
second_ndmi_invalid_mask = (
    second_scl_invalid_mask
    | (second_nir_raw == 0)
    | (second_swir_raw == 0)
)

# True-color RGB requires red, green, and blue.
second_rgb_invalid_mask = (
    second_scl_invalid_mask
    | (second_red_raw == 0)
    | (second_green_raw == 0)
    | (second_blue_raw == 0)
)

# A pixel is valid for the joint NDVI/NDMI comparison
# only when it is valid for both indices.
second_index_invalid_mask = (
    second_ndvi_invalid_mask
    | second_ndmi_invalid_mask
)

second_valid_mask = ~second_index_invalid_mask


# ---------------------------------------------------------
# 3. Quality-screening percentages
# ---------------------------------------------------------

second_valid_percentage = (
    second_valid_mask.sum()
    / second_valid_mask.size
    * 100
)

second_masked_percentage = (
    100 - second_valid_percentage
)

print(
    "Second-date valid observations:",
    f"{second_valid_percentage:.2f}%"
)

print(
    "Second-date masked observations:",
    f"{second_masked_percentage:.2f}%"
)


# ---------------------------------------------------------
# 4. Calculate second-date NDVI
# ---------------------------------------------------------

second_ndvi_denominator = (
    second_nir_reflectance
    + second_red_reflectance
)

second_ndvi = np.divide(
    second_nir_reflectance
    - second_red_reflectance,
    second_ndvi_denominator,
    out=np.full_like(
        second_ndvi_denominator,
        np.nan,
        dtype="float32"
    ),
    where=second_ndvi_denominator != 0
)


# ---------------------------------------------------------
# 5. Calculate second-date NDMI
# ---------------------------------------------------------

second_ndmi_denominator = (
    second_nir_reflectance
    + second_swir_reflectance
)

second_ndmi = np.divide(
    second_nir_reflectance
    - second_swir_reflectance,
    second_ndmi_denominator,
    out=np.full_like(
        second_ndmi_denominator,
        np.nan,
        dtype="float32"
    ),
    where=second_ndmi_denominator != 0
)


# ---------------------------------------------------------
# 6. Apply the appropriate mask to each index
# ---------------------------------------------------------

second_ndvi[
    second_ndvi_invalid_mask
] = np.nan

second_ndmi[
    second_ndmi_invalid_mask
] = np.nan


# ---------------------------------------------------------
# 7. Create and mask the second-date RGB image
# ---------------------------------------------------------

second_rgb_image = np.dstack([
    percentile_stretch(
        second_red_reflectance
    ),
    percentile_stretch(
        second_green_reflectance
    ),
    percentile_stretch(
        second_blue_reflectance
    )
])

second_rgb_masked = second_rgb_image.copy()

second_rgb_masked[
    second_rgb_invalid_mask
] = np.nan


# ---------------------------------------------------------
# 8. Check that valid pixels remain
# ---------------------------------------------------------

assert np.isfinite(second_ndvi).any(), (
