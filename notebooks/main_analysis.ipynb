## 13.5 Top Recommendations by Farmer

The following tables provide the three highest-ranked eligible crops for each farmer under both approaches. Final land allocation may include up to five crops due to the allocation constraints.

def top_recommendations(score_table, approach, top_n=3):
    result = (
        score_table[score_table["eligible"]]
        .sort_values(["farmer_id", "final_score"], ascending=[True, False])
        .groupby("farmer_id", group_keys=False)
        .head(top_n)
        .copy()
    )
    result["approach"] = approach
    return result[
        [
            "approach", "farmer_id", "crop", "crop_family",
            "final_score", "rank", "environmental_suitability",
            "water_compatibility", "objective_compatibility",
            "feed_contribution", "rotation_benefit",
            "diversity_benefit", "soil_health_benefit",
            "suitability_value_source", "suitability_is_assumption"
        ]
    ]


independent_top_recommendations = top_recommendations(
    independent_scores,
    "Independent"
)
diversity_top_recommendations = top_recommendations(
    diversity_scores,
    "Diversity-aware"
)

top_recommendation_comparison = pd.concat(
    [independent_top_recommendations, diversity_top_recommendations],
    ignore_index=True
)

